# MySQL (contenedor m7_mysql)
MYSQL_DATABASE=m7
MYSQL_USER=m7
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Para correr la API fuera de Docker (desde backend/)
DATABASE_URL=mysql+pymysql://m7:<MYSQL_PASSWORD>@localhost:3306/m7
# Para los tests de integración (contenedor mysql-test)
TEST_DATABASE_URL=mysql+pymysql://test:test@localhost:3307/m7_test

# Redis (Caché en memoria - RNF-11)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_ENABLED=true
REDIS_CACHE_TTL_SEGUNDOS=3600

# Keycloak
KC_PASSWORD=
M7_CLIENT_SECRET=

# true = la API no pide token (solo desarrollo)
AUTH_DISABLED=true
