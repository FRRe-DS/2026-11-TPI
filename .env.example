# Copiar a .env y completar. Nunca subir el .env al repositorio.

# Keycloak: contraseña del usuario admin de la consola local
KC_PASSWORD=
# Secreto del client confidencial m7-tarifas (el realm lo lee al importarse).
# Generar uno propio, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"
M7_CLIENT_SECRET=

# Base de datos de M7 (contenedor postgres del docker-compose)
POSTGRES_DB=m7
POSTGRES_USER=m7
POSTGRES_PASSWORD=
# Solo para correr la API fuera de Docker; dentro del compose se arma sola
DATABASE_URL=postgresql+psycopg://m7:<POSTGRES_PASSWORD>@localhost:5432/m7
# Solo para los tests de integración (servicio db-test del compose)
TEST_DATABASE_URL=postgresql+psycopg://test:test@localhost:5433/m7_test

# true omite la validación de tokens (solo desarrollo local)
AUTH_DISABLED=false

# Pasarela de pagos (simulada)
PASARELA_WEBHOOK_SECRET=
PASARELA_TIMEOUT_S=3

# Reglas de negocio (supuestos a acordar con el consorcio, ver docs/decisiones.md)
COMISION_PLATAFORMA=0.20
ESTIMACION_VIGENCIA_MIN=15
CANCELACION_PERIODO_GRACIA_MIN=5
CANCELACION_CARGO_ASIGNADO=500
CANCELACION_CARGO_CONDUCTOR_EN_PUNTO=1000

# Otros módulos (vacío = integración deshabilitada)
M4_UBICACION_URL=
M6_VIAJES_URL=
M9_RESERVAS_URL=
INTEGRACIONES_TIMEOUT_S=2
INTEGRACIONES_REINTENTOS=1
