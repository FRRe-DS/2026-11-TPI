# MySQL (contenedor m7_mysql)
MYSQL_DATABASE=m7
MYSQL_USER=m7
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Para correr la API fuera de Docker (desde backend/)
DATABASE_URL=mysql+pymysql://m7:<MYSQL_PASSWORD>@localhost:3306/m7
# Para los tests de integración (contenedor mysql-test)
TEST_DATABASE_URL=mysql+pymysql://test:test@localhost:3307/m7_test

# Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/ds-2026-realm
KC_PASSWORD=
M7_CLIENT_SECRET=

# true = la API no pide token (solo desarrollo local)
AUTH_DISABLED=true

# Secreto para autenticar webhooks de la pasarela de pagos
PASARELA_WEBHOOK_SECRET=
