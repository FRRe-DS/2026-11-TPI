# MySQL (contenedor m7_mysql)
MYSQL_DATABASE=m7
MYSQL_USER=m7
MYSQL_PASSWORD=admin
MYSQL_ROOT_PASSWORD=admin

# Para correr la API fuera de Docker (desde backend/)
DATABASE_URL=mysql+pymysql://m7:admin@localhost:3306/m7
# Para los tests de integración (contenedor mysql-test)
TEST_DATABASE_URL=mysql+pymysql://test:test@localhost:3307/m7_test

# Keycloak
KC_PASSWORD=admin
M7_CLIENT_SECRET=admin
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/ds-2026-realm
M4_UBICACION_URL=
M6_VIAJES_URL=
M9_RESERVAS_URL=
PASARELA_URL=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=m7
RABBITMQ_PASSWORD=m7
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=transporte

# true = la API no pide token (solo desarrollo)
AUTH_DISABLED=true

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=m7
RABBITMQ_PASSWORD=m7
RABBITMQ_EXCHANGE=viajes